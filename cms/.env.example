HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Cloudflare R2 media storage (S3-compatible). Only needed when running the CMS
# directly (outside Docker). With docker-compose these come from the root .env.
# Leave blank to store uploads on local disk (public/uploads).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Used once per boot by the relation-order backfill (cms/src/index.ts —
# revalidateWeb()) to purge the frontend's cache right after it fills in any
# NULL category/product relation-order links, so the corrected order shows up
# immediately instead of waiting up to an hour. Without both of these set, the
# backfill still runs (it's the source of truth in the DB either way) but the
# revalidate call is skipped — silently, with a log warning, no error. Must
# match the frontend's REVALIDATE_SECRET (root .env / web service) exactly.
#
# Admin content-edit webhooks (Settings → Webhooks in the Strapi admin) are a
# separate, per-environment manual setup — see deploy/README.md — and don't
# read these vars; they're configured entirely through the admin UI.
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=
