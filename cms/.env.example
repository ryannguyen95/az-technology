HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Cloudflare R2 media storage (S3-compatible). Only needed when running the CMS
# directly (outside Docker). With docker-compose these come from the root .env.
# Leave blank to store uploads on local disk (public/uploads).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# On-demand revalidation webhook (sort-manager reorder -> Next). Without both
# of these, `revalidateWeb()` in the sort-manager plugin's reorder service
# short-circuits and every save falls back to "may take up to an hour" —
# silently, with no error. Must match the frontend's REVALIDATE_SECRET
# (root .env / web service) exactly.
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=
